SESSION_SECRET=
ADMIN_USER=
ADMIN_HASH=

HEADLESS=true
MAX_CONCURRENT=13
STEP_METERS=1200
MAX_CELLS=0

MAX_LINKS_PER_CELL=0
RESET_EVERY_CELLS=3
BROWSER_MAX_AGE_MS=1800000

POLYGON_PATH=
FALLBACK_RADIUS_METERS=0
ALLOW_ROUGH_BBOX=false

# ====== ROTATING PROXY (residential gateway) ======
# Bật/tắt proxy xoay IP. Để false = chạy IP trực tiếp như cũ.
PROXY_ENABLED=false
# Endpoint gateway (ví dụ scrapegw: rp.scrapegw.com / 6060)
PROXY_HOST=
PROXY_PORT=
# Username BASE (kèm geo nếu có), ví dụ: 0tt9iqxs49v6hp3-country-us
PROXY_USERNAME=
PROXY_PASSWORD=
# true = mỗi browser giữ 1 IP cố định (sticky), đổi IP khi relaunch. Khuyến nghị: true
PROXY_STICKY=true
# Cách nhúng session id vào username để giữ sticky IP ({id} sẽ được thay tự động)
PROXY_STICKY_TEMPLATE=-session-{id}
# Tự kiểm tra & log egress IP mỗi lần (re)launch browser (mặc định = theo PROXY bật/tắt)
PROXY_VERIFY_IP=true

# ====== BLOCK ASSETS (tiết kiệm băng thông proxy) ======
# Chặn ảnh/media để đỡ tốn GB. AN TOÀN: không ảnh hưởng tên/phone/website/address
# (dữ liệu lấy từ DOM, không phải ảnh). KHÔNG chặn css/js/xhr.
BLOCK_ASSETS=false
BLOCK_ASSET_TYPES=image,media
